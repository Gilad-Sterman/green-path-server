# ─── Database (Supabase Postgres — direct connection, used by pg pool) ───────
DATABASE_URL=postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ─── Supabase (Storage + service-role access — NEVER expose to client) ───────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Note: anon key is NOT needed server-side. Service role has full access and bypasses RLS.

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Twilio (OTP SMS) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── OCR (Azure Document Intelligence) ───────────────────────────────────────
OCR_PROVIDER=azure
AZURE_OCR_ENDPOINT=
AZURE_OCR_KEY=

# ─── ERP Integration (Hashavshevet) — optional for MVP ───────────────────────
HASHAVSHEVET_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Dev Helpers ──────────────────────────────────────────────────────────────
# Set to true to skip Twilio and accept code 000000 for any phone number.
OTP_BYPASS=false
